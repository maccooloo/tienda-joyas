# Dominio de la tienda Shopify, por ejemplo: mi-tienda.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Token privado Storefront API del canal Headless. Mantener solo en .env.local.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Version estable de la Storefront API (documentada por Shopify).
SHOPIFY_API_VERSION=2026-10

# URL canonica para metadatos y sitemap una vez desplegado.
SITE_URL=http://localhost:3000